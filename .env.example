# Sprīdītis 3.3 alpha
#
# API atslēgas/globāli servisu parametri dzīvo .env.
# Pētījuma saturs, atslēgvārdi un crawler limiti dzīvo projects/*.json.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# AI batching / quota handling
# 10 objekti vienā Gemini pieprasījumā būtiski samazina request skaitu.
GEMINI_BATCH_SIZE=10

# Tavā pašreizējā free-tier kļūdā bija 5 requests/minute.
# Sprīdītis šo limitu ievēros kā slīdošu 60 sek. logu.
GEMINI_REQUESTS_PER_MINUTE=5

# 429/503 retry politika
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_SECONDS=5

# Optional SearchProvider for expedition mode.
# SearXNG JSON output must be enabled on the selected instance.
SEARXNG_BASE_URL=
SEARXNG_TIMEOUT_SECONDS=15

DB_PATH=data/spriditis.db
REPORT_DIR=reports

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
REPORT_TO=
SEND_EMAIL=false

USER_AGENT=SpriditisResearchBot/3.3 (+market research)
REQUEST_TIMEOUT_SECONDS=15
